                  "4–6 mmol/L en la primera hora",
                  "8 mmol/L"
                ],
                [
                  "Hiponatremia crónica sin síntomas graves",
                  "Cada 6 h durante 24 h; luego cada 12 h por 24 h",
                  "4–6 mmol/L",
                  "8 mmol/L"
                ],
                [
