          "responsable": "Jefe de la Unidad Técnica de Medicina Interna"
        },
        {
          "type": "Indicador",
          "name": "Clasificación volémica documentada (diagnóstico)",
          "tipoIndicador": "diagnóstico",
          "definicionIndicador": "Mide la proporción de pacientes en cuya historia clínica consta la clasificación de la hiponatremia como hipovolémica, euvolémica o hipervolémica antes del inicio del tratamiento.",
          "calculo": "(Numerador: pacientes con clasificación volémica registrada antes del tratamiento / Denominador: pacientes con hiponatremia hipotónica crónica) × 100",
          "meta": "≥85%",
          "periodo": "Trimestral",
          "responsable": "Coordinador General de Hospitalización y Ambulatorio"
        },
        {
          "type": "Indicador",
          "name": "Prescripción de restricción hídrica en antidiuresis inapropiada (tratamiento)",
          "tipoIndicador": "tratamiento",
          "definicionIndicador": "Mide la proporción de pacientes con diagnóstico de antidiuresis inapropiada en quienes se prescribió restricción hídrica de 800 a 1.000 mL en 24 horas como primera línea.",
          "calculo": "(Numerador: pacientes con SIAD y restricción hídrica prescrita como primera línea / Denominador: pacientes con diagnóstico de SIAD) × 100",
          "meta": "≥90%",
          "periodo": "Trimestral",
          "responsable": "Jefe de la Unidad Técnica de Medicina Interna"
        },
        {
          "type": "Indicador",
          "name": "Uso de solución hipertónica en síntomas graves (tratamiento)",
          "tipoIndicador": "tratamiento",
          "definicionIndicador": "Mide la proporción de pacientes con síntomas neurológicos graves que recibieron cloruro de sodio al 3 % en bolo dentro de la primera hora desde la identificación de los síntomas.",
          "calculo": "(Numerador: pacientes con síntomas graves tratados con NaCl 3 % en ≤1 h / Denominador: pacientes con hiponatremia y síntomas neurológicos graves) × 100",
          "meta": "≥95%",
          "periodo": "Trimestral",
          "responsable": "Jefe de Áreas Clínicas"
        },
        {
          "type": "Indicador",
          "name": "Control de sodio a las 6 horas de iniciada la corrección (seguimiento)",
          "tipoIndicador": "seguimiento",
          "definicionIndicador": "Mide la proporción de pacientes en corrección activa con al menos una determinación de sodio sérico dentro de las 6 horas siguientes al inicio del tratamiento.",
          "calculo": "(Numerador: pacientes con control de sodio en ≤6 h desde el inicio de la corrección / Denominador: pacientes que iniciaron corrección de hiponatremia) × 100",
          "meta": "≥90%",
          "periodo": "Mensual",
          "responsable": "Líder de Enfermería de Hospitalización"
        },
        {
          "type": "Indicador",
          "name": "Cita de control ambulatorio agendada al alta (seguimiento)",
          "tipoIndicador": "seguimiento",
          "definicionIndicador": "Mide la proporción de pacientes egresados con hiponatremia crónica que cuentan con cita de control en consulta externa de Medicina Interna agendada dentro de los 15 días posteriores al alta.",
          "calculo": "(Numerador: pacientes egresados con cita agendada en ≤15 días / Denominador: pacientes egresados con diagnóstico de hiponatremia crónica) × 100",
          "meta": "≥85%",
          "periodo": "Trimestral",
          "responsable": "Coordinador General de Hospitalización y Ambulatorio"
        },
        {
          "type": "Indicador",
          "name": "Corrección excesiva del sodio sérico (resultado)",
          "tipoIndicador": "resultado",
          "definicionIndicador": "Mide la proporción de pacientes en quienes el sodio sérico se incrementó más de 8 mmol/L en cualquier periodo de 24 horas durante la hospitalización.",
          "calculo": "(Numerador: pacientes con incremento de Na⁺ >8 mmol/L en 24 h / Denominador: pacientes en corrección de hiponatremia crónica) × 100",
          "meta": "≤5%",
          "periodo": "Mensual",
          "responsable": "Coordinador General de Control de Calidad"
        },
        {
          "type": "Indicador",
          "name": "Sodio sérico igual o mayor de 130 mmol/L al alta (resultado)",
          "tipoIndicador": "resultado",
          "definicionIndicador": "Mide la proporción de pacientes egresados con sodio sérico igual o mayor de 130 mmol/L en la última determinación previa al alta.",
          "calculo": "(Numerador: pacientes egresados con Na⁺ ≥130 mmol/L / Denominador: pacientes egresados con diagnóstico de hiponatremia crónica) × 100",
          "meta": "≥80%",
          "periodo": "Trimestral",
          "responsable": "Jefe de la Unidad Técnica de Medicina Interna"
        },
        {
          "type": "Indicador",
          "name": "Reingreso por hiponatremia a los 30 días (resultado)",
          "tipoIndicador": "resultado",
          "definicionIndicador": "Mide la proporción de pacientes egresados que reingresan al hospital con diagnóstico principal de hiponatremia dentro de los 30 días posteriores al alta.",
          "calculo": "(Numerador: reingresos por hiponatremia en ≤30 días / Denominador: pacientes egresados con diagnóstico de hiponatremia crónica) × 100",
          "meta": "≤10%",
          "periodo": "Semestral",
          "responsable": "Coordinador General de Investigación"
        }
      ],
      "tituloTabla": "Tabla 7. Indicadores de calidad del protocolo"
    },
