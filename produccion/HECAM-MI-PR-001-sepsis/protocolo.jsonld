                  "24 %",
                  "75 %",
                  "(-)",
                  "(-)"
                ],
                [
                  "NACIONAL — E. coli (n=85.291)",
                  "25 %",
                  "1.1 %",
                  "1.2 %",
                  "28 %",
                  "54 %",
                  "2.6 %"
                ],
                [
                  "NACIONAL — K. pneumoniae (n=21.226)",
                  "55 %",
                  "31.4 %",
                  "28.1 %",
                  "59.5 %",
                  "51.9 %",
                  "14.2 %"
                ]
              ],
              "fuente": "Cartilla de Resistencia Antibiótica HECAM 2025 e Informe Técnico SVPCS-DNVE-2026-02 (MSP/INSPI–CRN-RAM).[[4,5]]"
            },
            {
              "type": "Semaforo"
            },
            {
              "type": "Parrafo",
              "text": "**CONCLUSIÓN CLAVE:** el HECAM presenta una resistencia de __K. pneumoniae__ a carbapenémicos entre 1,5 y 2,5 veces superior al promedio nacional (49–76 % frente a 28–31 %). La ceftazidima/avibactam es la única opción con alta actividad (0–2 % de resistencia) frente a __K. pneumoniae__ CRE en UCI y bacteriemia del HECAM, lo que sustenta su indicación restringida y auditada por el PROA institucional[[17]]."
            }
          ],
