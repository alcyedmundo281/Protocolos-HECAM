        },
        {
          "sigla": "ATB",
          "significado": "Antibiótico / Antimicrobiano"
        },
        {
          "sigla": "PCR / PCT",
          "significado": "Proteína C reactiva / Procalcitonina"
        },
        {
          "sigla": "CRE",
          "significado": "Enterobacterales resistentes a carbapenémicos"
        },
        {
          "sigla": "BLEE",
          "significado": "Betalactamasas de espectro extendido"
        },
        {
          "sigla": "RAM",
