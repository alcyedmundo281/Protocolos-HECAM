          "significado": "Multirresistente / Resistencia extendida"
        },
        {
          "sigla": "PROA",
          "significado": "Programa de Optimización del Uso de Antimicrobianos"
        },
        {
          "sigla": "SSC",
          "significado": "__Surviving Sepsis Campaign__"
        },
        {
          "sigla": "TFG",
