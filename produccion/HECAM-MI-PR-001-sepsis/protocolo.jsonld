        {
          "type": "Anexo",
          "position": 3,
          "name": "Perfil de resistencia consolidado: Ecuador 2020-2024 frente a HECAM 2025",
          "contenido": [
            {
              "type": "Parrafo",
              "text": "Comparación entre los datos nacionales del Informe Técnico SVPCS-DNVE-2026-02[[4]] y los datos institucionales de la Cartilla de Resistencia HECAM 2025[[5]] para los microorganismos prioritarios en sepsis."
            },
            {
              "type": "TablaResistencia",
              "columnas": [
                "Organismo / fuente",
                "Ceftriaxona % R",
                "Imipenem % R",
                "Meropenem % R",
                "Ciprofloxacino % R",
                "TMP/SMX % R",
                "Ceftaz/Avibactam % R"
              ],
              "anchos": [
