                  "(-)",
                  "(-)"
                ],
                [
                  "K. pneumoniae — Unidad Técnica de Cuidados Intensivos resp./sangre (n=67)",
                  "54 %",
                  "50 %",
                  "49 %",
                  "67 %",
                  "(-)",
                  "0 %"
                ],
                [
                  "K. pneumoniae — bacteriemia Unidad Técnica de Medicina Interna (n=48)",
                  "(-)",
                  "76 %",
                  "56 %",
                  "79 %",
                  "(-)",
                  "2 %"
                ],
                [
                  "K. pneumoniae — Emergencia (n=158)",
                  "69 %",
