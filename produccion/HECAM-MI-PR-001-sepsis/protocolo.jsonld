                false
              ],
              "filas": [
                [
                  "E. coli — orina UCI/CC (n=64)",
                  "38 %",
                  "10 %",
                  "0 %",
                  "73 %",
                  "54 %",
                  "2 %"
                ],
                [
                  "E. coli — bacteriemia Unidad Técnica de Cuidados Intensivos (n=30)",
                  "(-)",
